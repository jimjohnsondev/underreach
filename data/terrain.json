{
 "_note": "What each tile does. 'blocks': nobody can walk on it. 'gate': blocks unless the Wayfarer has that gear (see data/gear.json). 'exit': stepping on it leaves a location. 'image': always draw this tile with another tile's picture. 'standIn': borrow this picture only until the tile has its own art in art/tiles.json. 'solid': the world generator can never put a road, trail or river through it. 'bridgeable': a road crossing it gets a bridge instead of a path.",
 "tiles": {
  "grass":       { "blocks": false },
  "grass_tufts": { "blocks": false },
  "wildflowers": { "blocks": false },
  "path":        { "blocks": false },
  "bridge":      { "blocks": false },
  "bridge_v":    { "blocks": false },
  "hills":       { "blocks": false },
  "sand":        { "blocks": false },
  "salt":        { "blocks": false },
  "marsh":       { "blocks": false },

  "tree":        { "blocks": true },
  "forest":      { "blocks": true },
  "mountain":    { "blocks": true },
  "sea":         { "blocks": true, "solid": true },
  "void":        { "blocks": true, "solid": true },

  "water":       { "blocks": false, "gate": "boat", "bridgeable": true },
  "deep_marsh":  { "blocks": false, "gate": "boat" },
  "cliff":       { "blocks": false, "gate": "hook" },
  "dark_forest": { "blocks": false, "gate": "lantern" },
  "border_gate": { "blocks": false, "gate": "seal" },

  "capital":     { "blocks": false },
  "house":       { "blocks": false },
  "town":        { "blocks": false },
  "village":     { "blocks": false },
  "ruin":        { "blocks": false },
  "cave":        { "blocks": false },
  "tower":       { "blocks": false },
  "waystone":    { "blocks": false },
  "landmark":    { "blocks": false },

  "cobbles":     { "blocks": false, "standIn": "path" },
  "floor":       { "blocks": false, "standIn": "bridge" },
  "door":        { "blocks": false, "standIn": "path" },
  "garden":      { "blocks": false, "standIn": "wildflowers" },
  "carpet":      { "blocks": false, "standIn": "sand" },
  "wall":        { "blocks": true,  "standIn": "cliff" },
  "castle_wall": { "blocks": true,  "standIn": "mountain" },
  "counter":     { "blocks": true,  "standIn": "bridge_v" },
  "fence":       { "blocks": true,  "standIn": "tree" },
  "well":        { "blocks": true,  "standIn": "water" },
  "stall":       { "blocks": true,  "standIn": "forest" },
  "throne":      { "blocks": true,  "standIn": "forest" },

  "ruin_floor":  { "blocks": false, "standIn": "salt" },
  "moss":        { "blocks": false, "standIn": "grass_tufts" },
  "stairs_down": { "blocks": false, "standIn": "cave" },
  "ruin_wall":   { "blocks": true,  "standIn": "mountain" },
  "rubble":      { "blocks": true,  "standIn": "hills" },
  "pillar":      { "blocks": true,  "standIn": "cliff" },
  "altar":       { "blocks": true,  "standIn": "dark_forest" },

  "exit":        { "blocks": false, "exit": true, "image": "path" }
 }
}
