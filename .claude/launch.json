{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "underreach",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "underreach-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "underreach-python",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "underreach-editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "editor"
      ],
      "port": 5180
    }
  ]
}
